{
  "name": "swiggy-instamart-whatsapp-agent",
  "version": "1.0.0",
  "description": "Profile-scoped WhatsApp agents for ordering from Swiggy Food and Instamart, with a private household configuration desk.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "test:agent": "ts-node src/test_agent.ts",
    "test:cloud": "ts-node src/test_meta_cloud.ts",
    "test:dashboard": "ts-node src/test_dashboard.ts",
    "test:payment-safety": "ts-node src/test_payment_safety.ts",
    "test:profiles": "ts-node src/test_profiles.ts",
    "test:swiggy-auth": "ts-node src/test_swiggy_auth.ts",
    "test:webhook-auth": "ts-node src/test_webhook_signature.ts",
    "build": "tsc && node dist/copy-dashboard-assets.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
