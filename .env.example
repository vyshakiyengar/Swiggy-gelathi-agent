# =================================================================
# Zepto WhatsApp Agent Environment Configuration
# =================================================================

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Meta WhatsApp Business Cloud API Configuration
# Get these credentials from Meta for Developers (https://developers.facebook.com/) -> App Dashboard -> WhatsApp -> API Setup:
WHATSAPP_TOKEN=EAAG...your_meta_system_user_or_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id_here
WHATSAPP_VERIFY_TOKEN=zepto_mom_agent_secret_2026
WHATSAPP_API_VERSION=v21.0

# 3. Server Configuration
PORT=3000
NODE_ENV=development

# 4. User Profile & Delivery Defaults (Bengaluru Darkstore)
DEFAULT_DELIVERY_ADDRESS="Flat 302, Green Glen Layout, Bellandur, Bengaluru - 560103"
DEFAULT_USER_NAME="Amma"
UPI_PAYMENT_VPA="zepto.orders@icici"
UPI_PAYEE_NAME="Zepto Grocery"
