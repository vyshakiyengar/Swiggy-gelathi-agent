# =================================================================
# Swiggy Instamart WhatsApp Agent Environment Configuration
# =================================================================

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# 2. Meta WhatsApp Business Cloud API Configuration
# Get these credentials from Meta for Developers (https://developers.facebook.com/) -> App Dashboard -> WhatsApp -> API Setup:
WHATSAPP_TOKEN=EAAG...your_meta_system_user_or_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id_here
WHATSAPP_VERIFY_TOKEN=choose_a_unique_webhook_verification_token
# Meta App Dashboard -> App settings -> Basic. Required to authenticate webhook POST bodies.
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_API_VERSION=v21.0
# Keep false in production. True is accepted only from a loopback peer in development/test.
WHATSAPP_WEBHOOK_ALLOW_UNSIGNED_LOCAL=false

# 3. Server Configuration
PORT=3000
NODE_ENV=development
# Public URL this server is reachable at - used as the Swiggy OAuth redirect target.
PUBLIC_BASE_URL=https://your-app.onrender.com
# Required in production to open the private household configuration dashboard.
DASHBOARD_PASSWORD=choose_a_long_unique_password
# Optional local-only convenience. The bypass requires this exact value, a
# loopback client, no configured password, and non-production NODE_ENV.
DASHBOARD_ALLOW_LOCAL_AUTH_BYPASS=false
# Local default: .agent-data/agent-profiles.json. On Render, point this at a persistent disk.
AGENT_PROFILE_STORE_PATH=

# The two WhatsApp recipients managed by the first household dashboard.
# Country code included, digits only, no "+".
# Incoming routing is fail-closed: blank or unknown numbers never inherit
# another profile, Swiggy session, address, cart, or preferences.
MOTHER_WHATSAPP_NUMBER=919876543210
SELF_WHATSAPP_NUMBER=919876543211

# 4. Swiggy Instamart MCP (mcp.swiggy.com/im) - real account, real orders, no sandbox.
# Obtained via a one-time interactive login (see README "Linking Swiggy"); access tokens last
# ~5 days and are renewed via a WhatsApp-delivered relink link, not a refresh token (Swiggy's
# auth server doesn't issue one).
SWIGGY_ACCESS_TOKEN=your_swiggy_mcp_access_token_here
# Optional: epoch ms the token above was issued, for accurate expiry tracking after a redeploy.
SWIGGY_TOKEN_ISSUED_AT=
# Swiggy's internal ID for the one saved address this bot always delivers to.
SWIGGY_DEFAULT_ADDRESS_ID=your_swiggy_saved_address_id_here
# Coordinates for the legacy mother-profile seed. Once an address is selected in the dashboard,
# that profile-scoped value is used instead.
SWIGGY_DEFAULT_LAT=
SWIGGY_DEFAULT_LNG=

# 5. Gnani speech-to-text / text-to-speech (voice notes) - TRIAL, optional.
# Leave unset to fall back to Gemini's own native audio understanding for voice note input
# (still works fine, just without Gnani's faster/native-Kannada STT) and skip the spoken
# Kannada voice-note reply entirely (text reply always still sent either way). See README
# "Removing Gnani" for the full revert.
GNANI_API_KEY=
